network:
  version: 2
  ethernets:
    enp3s0:
      match:
        macaddress: "fa:16:3e:f9:17:95"
      dhcp4: true
      dhcp6: true
      accept-ra: true
      dhcp4-overrides:
        route-metric: 100
      dhcp6-overrides:
        route-metric: 100
      set-name: "enp3s0"

    enp4s0:
      match:
        macaddress: "fa:16:3e:3b:f9:5d"
      dhcp4: true
      dhcp4-overrides:
        route-metric: 200
      set-name: "enp4s0"   
