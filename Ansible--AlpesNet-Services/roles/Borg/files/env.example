# Local path to the repo, as seen INSIDE the container. Must match the
# /repo volume mount in docker-compose.yml.
BORG_REPO=/repo

BORG_KEY_FILE=/keys/repo.key

# Passphrase that unlocks repo.key (NOT the key file itself).
BORG_PASSPHRASE=<change-me>

# Optional overrides
ARCHIVE_NAME_PREFIX=<my host>
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Name (or container ID) of your running LDAP container, as shown by
# `docker ps`. Leave unset/commented to skip LDAP dumping entirely.
LDAP_CONTAINER_NAME=<openldap>
