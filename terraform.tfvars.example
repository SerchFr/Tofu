# Copy this file to terraform.tfvars and edit the keypair name.
#
# IMPORTANT: terraform.tfvars can contain sensitive infrastructure settings.
# Do not commit credentials or private keys.

instance_name      = "instance-1"
network_name       = "ext-net1"
fixed_ip           = "195.15.202.18"
flavor_name        = "a1-ram2-disk50-perf1"
keypair_name       = "YOUR_EXISTING_INFOMANIAK_KEYPAIR_NAME"

ssh_source_cidr    = "90.38.162.195/32"
security_group_name = "instance-1-sg"

# Change this only if your Infomaniak project is in another region.
region = "dc3-a"
